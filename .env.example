# 在 Notion 开发者后台创建“内部集成”，复制令牌后在 PowerShell 中设置。
# 不要把真实令牌写进这个文件或提交到版本控制。
NOTION_API_KEY=ntn_your_internal_integration_token
NOTION_DATABASE_ID=3b893e41daef805e8d84e4ea188657ac
# 数据库只有一个数据源时无需填写：
# NOTION_DATA_SOURCE_ID=

# Google 免费翻译请求间隔（秒）与双通道重试次数
GOOGLE_TRANSLATE_DELAY_SECONDS=0.45
GOOGLE_TRANSLATE_MAX_ATTEMPTS=3

# GitHub Actions 使用 Google Apps Script 免费中转，避免共享 IP 被 Google 限流
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_APPS_SCRIPT_TOKEN=replace_with_a_long_random_value
