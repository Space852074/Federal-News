# 在 Notion 开发者后台创建“内部集成”，复制令牌后在 PowerShell 中设置。
# 不要把真实令牌写进这个文件或提交到版本控制。
NOTION_API_KEY=ntn_your_internal_integration_token
NOTION_DATABASE_ID=3b893e41daef805e8d84e4ea188657ac
# 数据库只有一个数据源时无需填写：
# NOTION_DATA_SOURCE_ID=

# Azure Translator F0（密钥不可提交到版本控制）
AZURE_TRANSLATOR_KEY=your_azure_translator_key
# global 单服务资源可留空；区域或多服务资源必须填写，例如 eastasia
AZURE_TRANSLATOR_REGION=
# 可选；未设置时使用 Azure 全球翻译端点
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
